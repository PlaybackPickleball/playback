# Copy to .env only if you need to override the defaults.
# No secrets. The app runs without this file.

# API bind address when LAN mode is off. LAN mode itself binds 0.0.0.0.
HOST=127.0.0.1
PORT=8787

# Origin encoded in QR codes and session links.
# Leave this unset, or set a real host, when using npm run dev:lan.
# A localhost value is ignored while LAN mode is on, so the QR code is not a silent localhost URL.
# Dev (Vite): http://127.0.0.1:5173
# Production (npm start): http://127.0.0.1:8787
# An explicit non-localhost value always wins, for example http://192.168.1.20:5173
PUBLIC_BASE_URL=http://127.0.0.1:5173

# Maximum upload size for one recording.
UPLOAD_LIMIT_MB=512

# Recording files and SQLite database. Relative paths are from the repo root.
STORAGE_DIR=data/recordings
DATABASE_PATH=data/court-replay.db

# Automatic stop-and-save limit for the demo, in seconds. Default is 10 minutes.
RECORDING_LIMIT_SECONDS=600

# Set true only on a trusted Wi-Fi. Prefer `npm run dev:lan`, which turns this on
# and binds the dev site and API so a phone can open the laptop. There is no production login.
LAN_MODE=false
